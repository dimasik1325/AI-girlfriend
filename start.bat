@echo off
rem ============================================================
rem  AI Girlfriend — запуск двойным кликом.
rem  Закрыл страницу в браузере -> консоль закрывается сама.
rem ============================================================
chcp 65001 >nul
title AI Girlfriend
cd /d "%~dp0"

where node >nul 2>&1
if errorlevel 1 (
    rem Node.js не установлен: просто открываем страницу с диска,
    rem она умеет работать без сервера (офлайн-режим).
    start "" "%~dp0index.html"
    exit /b 0
)

rem Консоль живёт, пока открыта вкладка: страница держит соединение,
rem закрыл её - сервер сам завершится и окно погаснет.
set AUTO_EXIT=1
set PORT=3000
node server.js
if errorlevel 1 (
    echo.
    echo Сервер завершился с ошибкой. Если пишет "порт занят" -
    echo закрой другую копию этого окна и запусти снова.
    pause
)
